{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.8.0",
  "default_locale": "en",
  "key": "",
  "update_url": "https://echolike.app/extension_update.json",
  "description": "__MSG_extDescription__",
  "externally_connectable": {
    "matches": [
      "https://echolike.app/*"
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://ntfy.sh/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.x.com/*",
    "https://mobile.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "echolike@nova-radar",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}