# Store secrets — NEVER commit. chmod 600. Scripts read this file only.
# Fill in: see store/first-time.md for where each value comes from (5 min in your browsers).
# Nothing here ever goes in chat, logs, or the repo.

# Chrome Web Store Publish API (Google Cloud OAuth client, desktop type)
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
# Fill AFTER the first manual dashboard upload (API cannot create items):
CWS_APP_ID=

# Firefox AMO (Developer Hub -> API credentials, 30 seconds)
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
